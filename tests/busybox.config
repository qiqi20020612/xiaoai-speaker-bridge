# Official, unmodified BusyBox 1.36.1 applets used by the Linux CI fixtures.
# Other commands come from the fixture PATH; do not enable standalone/nofork.
CONFIG_BUSYBOX=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_FLOCK=y
CONFIG_AWK=y
CONFIG_FEATURE_AWK_LIBM=y
CONFIG_SED=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
